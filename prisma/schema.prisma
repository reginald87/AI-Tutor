generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  passwordHash        String
  role                String          @default("STUDENT")
  matricNumber        String?         @unique
  department          String?
  faculty             String?
  program             String?
  level               String?
  verified            Boolean         @default(false)
  verifyToken         String?         @unique
  verifyTokenExpires  DateTime?
  mustChangePassword  Boolean         @default(false)
  rewardPoints        Int             @default(0)
  promptsPerDay       Int             @default(5)
  promptsPerWeek      Int             @default(35)
  dailyUsed           Int             @default(0)
  weeklyUsed          Int             @default(0)
  dailyResetAt        DateTime        @default(now())
  weeklyResetAt       DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  resetToken          String?         @unique
  resetTokenExpires   DateTime?
  announcements       Announcement[]
  assignments         Assignment[]
  attempts            Attempt[]
  chats               Chat[]
  documents           Document[]
  answeredEscalations Escalation[]    @relation("EscalationAnswerer")
  escalations         Escalation[]    @relation("EscalationAuthor")
  flashcardDecks      FlashcardDeck[]
  quizzes             Quiz[]
  reviewItems         ReviewItem[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  filename  String
  mimeType  String
  size      Int
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New chat")
  docId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  role       String
  content    String
  createdAt  DateTime @default(now())
  confidence String?
  sources    String?
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Quiz {
  id            String       @id @default(cuid())
  title         String
  description   String?
  creatorId     String
  isAdminQuiz   Boolean      @default(false)
  faculty       String?
  department    String?
  program       String?
  level         String?
  sourceDocId   String?
  generatedFrom String?
  status        String       @default("DRAFT")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  error         String?
  assignments   Assignment[]
  attempts      Attempt[]
  questions     Question[]
  creator       User         @relation(fields: [creatorId], references: [id])

  @@index([isAdminQuiz, status])
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  prompt       String
  options      String
  correctIndex Int
  explanation  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  total       Int
  percentage  Float
  answers     String
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([quizId])
}

model Setting {
  id                    String   @id @default("global")
  defaultPromptsPerDay  Int      @default(5)
  defaultPromptsPerWeek Int      @default(35)
  defaultModel          String   @default("llama3.2:latest")
  fastModel             String?
  updatedAt             DateTime @updatedAt
  visionModel           String?
  provider              String   @default("ollama")
  openaiApiKey          String?
  anthropicApiKey       String?
  openrouterApiKey     String?
  googleApiKey          String?
  deepseekApiKey        String?
  customApiBase         String?
  customApiKey          String?
  customModel           String?
}

model Announcement {
  id         String   @id @default(cuid())
  authorId   String
  title      String
  body       String
  faculty    String?
  department String?
  program    String?
  level      String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Escalation {
  id           String   @id @default(cuid())
  userId       String
  chatId       String?
  subject      String
  message      String
  status       String   @default("OPEN")
  answer       String?
  answeredById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  answeredBy   User?    @relation("EscalationAnswerer", fields: [answeredById], references: [id])
  user         User     @relation("EscalationAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model FlashcardDeck {
  id           String      @id @default(cuid())
  userId       String
  title        String
  sourceDocId  String?
  sourceQuizId String?
  status       String      @default("PUBLISHED")
  error        String?
  createdAt    DateTime    @default(now())
  cards        Flashcard[]
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Flashcard {
  id          String        @id @default(cuid())
  deckId      String
  front       String
  back        String
  dueAt       DateTime      @default(now())
  interval    Int           @default(0)
  ease        Float         @default(2.5)
  repetitions Int           @default(0)
  lastRating  Int?
  createdAt   DateTime      @default(now())
  deck        FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@index([dueAt])
}

model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  questionId   String
  prompt       String
  options      String
  correctIndex Int
  explanation  String?
  dueAt        DateTime @default(now())
  interval     Int      @default(0)
  ease         Float    @default(2.5)
  repetitions  Int      @default(0)
  lastRating   Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueAt])
}

model Assignment {
  id           String    @id @default(cuid())
  quizId       String
  assignedById String
  title        String
  faculty      String?
  department   String?
  program      String?
  level        String?
  dueAt        DateTime?
  createdAt    DateTime  @default(now())
  assignedBy   User      @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
