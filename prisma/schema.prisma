generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("STUDENT") // STUDENT | ADMIN
  matricNumber  String?  @unique
  department    String?
  faculty       String?
  program       String?
  level         String?

  verified      Boolean  @default(false)
  verifyToken   String?  @unique
  verifyTokenExpires DateTime?

  // When true the user must change their password on next login (seed/admin reset).
  mustChangePassword Boolean @default(false)

  // Password reset (forgot-password flow + admin reset).
  resetToken String? @unique
  resetTokenExpires DateTime?

  // Reward points earned by passing quizzes (encouragement system)
  rewardPoints  Int      @default(0)

  // Prompt accounting (consumed per AI generation request)
  promptsPerDay   Int      @default(5)
  promptsPerWeek  Int      @default(35)
  dailyUsed       Int      @default(0)
  weeklyUsed      Int      @default(0)
  dailyResetAt    DateTime @default(now())
  weeklyResetAt   DateTime @default(now())

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents   Document[]
  chats       Chat[]
  quizzes     Quiz[]
  attempts    Attempt[]

  announcements Announcement[]
  escalations  Escalation[] @relation("EscalationAuthor")
  answeredEscalations Escalation[] @relation("EscalationAnswerer")
  flashcardDecks FlashcardDeck[]
  reviewItems  ReviewItem[]
  assignments  Assignment[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  text      String // extracted plain text used for RAG context
  createdAt DateTime @default(now())

  @@index([userId])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  docId     String? // active document context for this chat
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String // user | assistant | system
  content   String
  // JSON array of { docId, filename, snippet } retrieved to ground this reply.
  sources   String?
  // Model's self-reported confidence: "high" | "medium" | "low"
  confidence String?
  createdAt DateTime @default(now())

  @@index([chatId])
}

model Quiz {
  id            String   @id @default(cuid())
  title         String
  description   String?
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id])
  isAdminQuiz   Boolean  @default(false)

  // Targeting (admin quizzes shown to matching students)
  faculty       String?
  department    String?
  program       String?
  level         String?

  // Provenance
  sourceDocId   String?
  generatedFrom String? // 'document' | 'topic' | 'manual'
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | GENERATING | FAILED
  // Set when async background generation fails (status = FAILED).
  error    String?

  questions     Question[]
  attempts      Attempt[]
  assignments   Assignment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isAdminQuiz, status])
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt       String
  options      String // JSON-encoded string[]
  correctIndex Int
  explanation  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([quizId])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  score       Int
  total       Int
  percentage  Float
  answers     String // JSON-encoded array of { questionId, selectedIndex, correct }
  completedAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}

model Setting {
  id                    String @id @default("global")
  defaultPromptsPerDay  Int    @default(5)
  defaultPromptsPerWeek Int    @default(35)
  defaultModel          String @default("llama3.2:latest")
  // Optional vision model used for image input (e.g. llava).
  visionModel           String?
  updatedAt             DateTime @updatedAt
}

// ---- Announcements (admin notice board) ----
model Announcement {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // Targeting (null/empty = everyone). Matches student profile fields.
  faculty    String?
  department String?
  program    String?
  level      String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- Ask-a-human escalation ----
model Escalation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("EscalationAuthor", fields: [userId], references: [id], onDelete: Cascade)
  chatId        String?
  subject       String
  message       String
  status        String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  answer        String?
  answeredById  String?
  answeredBy    User?    @relation("EscalationAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

// ---- Flashcards (with built-in spaced repetition) ----
model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  sourceDocId String?
  sourceQuizId String?
  // GENERATING (async job in progress) | PUBLISHED (ready) | FAILED (generation error)
  status      String   @default("PUBLISHED")
  // Error detail when status = FAILED.
  error       String?
  createdAt   DateTime @default(now())

  cards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id           String   @id @default(cuid())
  deckId       String
  deck         FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front        String
  back         String
  // Spaced-repetition state (SM-2 style)
  dueAt        DateTime @default(now())
  interval     Int      @default(0)
  ease         Float    @default(2.5)
  repetitions  Int      @default(0)
  lastRating   Int?
  createdAt    DateTime @default(now())

  @@index([deckId])
  @@index([dueAt])
}

// ---- Spaced repetition for quiz mistakes ----
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId       String
  questionId   String
  prompt       String
  options      String // JSON-encoded string[]
  correctIndex Int
  explanation  String?
  // Spaced-repetition state
  dueAt        DateTime @default(now())
  interval     Int      @default(0)
  ease         Float    @default(2.5)
  repetitions  Int      @default(0)
  lastRating   Int?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([dueAt])
}

// ---- Bulk quiz assignment (admin -> cohorts) ----
model Assignment {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  title        String
  faculty      String?
  department   String?
  program      String?
  level        String?
  dueAt        DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
