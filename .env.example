# Environment
DATABASE_URL="file:./prod.db"
JWT_SECRET="change-this-to-a-long-random-string-bmu-ai-tutor-2026"
# Initial admin password used by `prisma db seed`. REQUIRED in production.
ADMIN_PASSWORD="set-a-strong-password-here"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
NEXT_PUBLIC_APP_NAME="BMU AI Tutor"
APP_URL="https://your-domain-here"

# Only emails on this domain may register (keeps outsiders out)
ALLOWED_EMAIL_DOMAIN="bmu.edu.ng"

# SMTP (Gmail) — use a Google "App Password", not your normal password
# Enable 2-Step Verification, then create one at:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="bmudigitalinnovation@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="BMU AI Tutor <bmudigitalinnovation@gmail.com>"

